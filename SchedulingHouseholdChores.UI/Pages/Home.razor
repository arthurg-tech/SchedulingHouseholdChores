@page "/"
@using SchedulingHouseholdChores.UI.Services
@inject AuthClientService AuthService
@inject NavigationManager Navigation

<PageTitle>Home - Gerenciador de Tarefas</PageTitle>

<div class="container mt-5">
    @if (isAuthenticated)
    {
        <div class="alert alert-success" role="alert">
            <h4 class="alert-heading">Bem-vindo, @userName!</h4>
            <p>Você está autenticado e pode gerenciar suas tarefas domésticas.</p>
            <hr>
            <button class="btn btn-primary" @onclick="GotoTasks">
                Ir para Minhas Tarefas
            </button>
        </div>
    }
    else
    {
        <div class="text-center">
            <h1 class="mb-4">Gerenciador de Tarefas Domésticas</h1>
            <p class="lead mb-4">Organize e acompanhe suas tarefas por área e frequência</p>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">👤 Contas Pessoais</h5>
                            <p class="card-text">Cada pessoa tem seu próprio espaço privado para gerenciar tarefas.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">✓ Rastreamento</h5>
                            <p class="card-text">Acompanhe quando cada tarefa foi feita e quando é necessário repetir.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">📅 Planejamento</h5>
                            <p class="card-text">Organize tarefas por frequência e receba lembretes automáticos.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <h3 class="mb-4">Comece Agora</h3>
                <button class="btn btn-primary btn-lg me-3" @onclick="GotoLogin">
                    Entrar
                </button>
                <button class="btn btn-success btn-lg" @onclick="GotoRegister">
                    Criar Conta
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isAuthenticated = false;
    private string userName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            userName = "Usuário";
        }
    }

    private void GotoTasks() => Navigation.NavigateTo("/tasks");
    private void GotoLogin() => Navigation.NavigateTo("/login");
    private void GotoRegister() => Navigation.NavigateTo("/register");
}
